# 数据库配置（默认使用 SQLite，如需 MySQL 请取消注释）
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=myweb
# DB_USER=myweb
# DB_PASSWORD=your_password_here
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Redis 配置（用于 Channels WebSocket）
REDIS_URL=redis://127.0.0.1:6379/0

# Django 配置
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# Dify AI API 配置（可选，用于 @星辰AI助手）
AI_API_KEY=your-dify-api-key
AI_API_BASE_URL=https://api.dify.ai/v1/workflows/run
AI_USE_REAL_API=False
